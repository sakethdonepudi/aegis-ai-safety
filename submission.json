{
  "project": "AEGIS",
  "tagline": "Verify Before You Trust.",
  "repository": "https://github.com/sakethdonepudi/aegis-ai-safety",
  "version": "0.1.0",
  "status": "Initial vertical slice implemented and locally tested",
  "category": "AI Safety / Trustworthy AI / Research Infrastructure",
  "stack": {
    "frontend": ["Next.js App Router", "TypeScript", "Tailwind CSS", "shadcn/ui", "Lucide", "Recharts"],
    "backend": ["Python", "FastAPI", "Pydantic", "Uvicorn"],
    "database": "IBM Db2 Community Edition 12.1.5",
    "ai_orchestration": "LangChain with a configurable OpenAI-compatible chat model",
    "documents": "PyMuPDF"
  },
  "database": {
    "schema": "AEGIS",
    "tables": [
      "DOCUMENTS",
      "PASSAGES",
      "VERIFICATION_SESSIONS",
      "CLAIMS",
      "VERIFICATION_RESULTS",
      "EVIDENCE_LINKS"
    ],
    "referential_integrity": true,
    "indexes": true,
    "parameterized_sql": true
  },
  "classifications": [
    "SUPPORTED",
    "CONTRADICTED",
    "INSUFFICIENT_EVIDENCE",
    "VERIFICATION_ERROR"
  ],
  "demo": {
    "type": "synthetic",
    "label": "Fictional SolarCell-X evidence; classifications generated by the pipeline",
    "hardcoded_expectations": false,
    "verified_with": "ollama/qwen2.5:7b-instruct (local, temperature 0)",
    "verified_outcome": {
      "total_claims": 3,
      "supported": 1,
      "contradicted": 1,
      "insufficient_evidence": 1,
      "verification_error": 0,
      "persisted_in_db2": true
    }
  },
  "evaluation": {
    "dataset": "SciFact",
    "license": "CC BY-NC 2.0",
    "benchmark_executed": false,
    "metrics_implemented": [
      "macro_f1",
      "precision",
      "recall",
      "confusion_matrix",
      "false_positive_analysis",
      "retrieval_recall_at_k",
      "latency"
    ]
  },
  "documentation": {
    "architecture": "docs/architecture.md",
    "api": "docs/api.md",
    "demo": "docs/demo.md",
    "limitations": "docs/limitations.md",
    "research": "research/methodology.md"
  }
}
