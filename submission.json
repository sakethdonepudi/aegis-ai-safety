{
  "project": "AEGIS",
  "full_name": "AI Evidence Grounding & Integrity System",
  "tagline": "Verify Before You Trust.",
  "repository": "https://github.com/sakethdonepudi/aegis-ai-safety",
  "version": "0.2.0",
  "hackathon": "Db2Hack 2026",
  "status": "Working vertical slice with report export, document inspection, numeric checks, evaluation empty state, and a real-paper demo",
  "category": "AI Safety / Trustworthy AI / Research Infrastructure",
  "stack": {
    "frontend": ["Next.js App Router", "TypeScript", "Tailwind CSS", "shadcn/ui", "Lucide", "Recharts"],
    "backend": ["Python", "FastAPI", "Pydantic", "Uvicorn", "HTTPX", "PyMuPDF"],
    "database": "IBM Db2 Community Edition 12.1.5",
    "ai_orchestration": "LangChain with a configurable OpenAI-compatible chat model",
    "documents": "PyMuPDF"
  },
  "database": {
    "schema": "AEGIS",
    "tables": [
      "DOCUMENTS",
      "PASSAGES",
      "VERIFICATION_SESSIONS",
      "CLAIMS",
      "VERIFICATION_RESULTS",
      "EVIDENCE_LINKS"
    ],
    "migrations": "database/init_db.py applies missing columns and indexes idempotently",
    "referential_integrity": true,
    "indexes": true,
    "parameterized_sql": true
  },
  "features": [
    "LangChain atomic claim extraction",
    "Db2-backed lexical retrieval with BM25 ranking",
    "Evidence-grounded SUPPORTED / CONTRADICTED / INSUFFICIENT_EVIDENCE / VERIFICATION_ERROR",
    "Passage-ID validation and fabricated-citation downgrade",
    "Deterministic numeric consistency checks",
    "PDF/TXT/MD ingestion with page and character provenance",
    "Claim inspector with evidence, page, relationship, explanation, limitations, and numeric check",
    "JSON and Markdown report export",
    "Verification history and session reopening",
    "Document detail API and evaluation status endpoint",
    "SciFact evaluation harness and metrics (no benchmark executed)"
  ],
  "classifications": [
    "SUPPORTED",
    "CONTRADICTED",
    "INSUFFICIENT_EVIDENCE",
    "VERIFICATION_ERROR"
  ],
  "demo": {
    "paper": {
      "evidence": "Attention Is All You Need (arXiv 1706.03762) and BERT (arXiv 1810.04805)",
      "evidence_committed": false,
      "download_command": "make demo-papers",
      "hardcoded_expectations": false,
      "verified_with": "ollama/qwen2.5:7b-instruct (local, temperature 0)",
      "verified_outcome": {
        "total_claims": 4,
        "supported": 1,
        "contradicted": 2,
        "insufficient_evidence": 1,
        "verification_error": 0,
        "numeric_discrepancy": "claimed 8 encoder layers; cited paper states 6",
        "persisted_in_db2": true
      }
    },
    "synthetic": {
      "evidence": "Fictional SolarCell-X study",
      "hardcoded_expectations": false,
      "verified_outcome": {
        "total_claims": 3,
        "supported": 1,
        "contradicted": 1,
        "insufficient_evidence": 1,
        "verification_error": 0
      }
    }
  },
  "evaluation": {
    "dataset": "SciFact",
    "license": "CC BY-NC 2.0",
    "benchmark_executed": false,
    "results_exposed_only_if_present": true,
    "metrics_implemented": [
      "macro_f1",
      "precision",
      "recall",
      "confusion_matrix",
      "false_positive_analysis",
      "retrieval_recall_at_k",
      "latency"
    ]
  },
  "documentation": {
    "architecture": "docs/architecture.md",
    "api": "docs/api.md",
    "demo": "docs/demo.md",
    "macos_setup": "docs/setup-macos.md",
    "security": "docs/security.md",
    "deployment": "docs/deployment.md",
    "limitations": "docs/limitations.md",
    "research": "research/methodology.md"
  },
  "submission_notes": "No public Db2Hack organizer submission template/repository was discoverable at build time. This file is project metadata; adapt field names if the organizers publish a required schema."
}
